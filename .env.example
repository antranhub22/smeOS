DATABASE_URL="postgresql://smeos:smeos@localhost:5433/smeos"

# Khoá nhà cung cấp AI — khoá nền tảng, không phải khoá của tổ chức (D2).
# Không bao giờ đi qua trình duyệt, không bao giờ nằm trong bảng nào.
OPENAI_API_KEY=

# ElevenLabs — giọng đọc ElevenLabs và Voice Clone (Khu vực C, 24/09/2026).
# Nhân bản giọng cần gói có Instant Voice Clone (Starter trở lên). Web dùng khoá
# này để gỡ giọng khi xoá; worker dùng để nhân bản và đọc.
ELEVENLABS_API_KEY=

# SerpApi API Key — Phục vụ phân hệ Market Intelligence & Nghiên cứu thị trường
# Quét đa kênh realtime: Google Trends, TikTok Reels, Facebook Social, YouTube
SERPAPI_API_KEY=

# Kho tệp
# Kho tệp dùng chung, tương thích S3 (Amazon S3, Cloudflare R2, MinIO).
# Đủ bốn ô thì web và worker đọc/ghi qua kho này; thiếu một ô thì cả hai rơi
# về `var/storage` trên đĩa của chính tiến trình — chỉ dùng được khi web và
# worker đứng trên cùng một máy, và ảnh mất sau mỗi lần triển khai lại.
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# `auto` cho Cloudflare R2; tên vùng thật cho Amazon S3 (ví dụ ap-southeast-1).
STORAGE_REGION=auto

# Redis dùng chung cho giới hạn tần suất endpoint công khai (Thẻ chào).
# Trống → đếm trong bộ nhớ tiến trình (dev/một instance).
REDIS_URL=
# Số proxy tin cậy đứng trước app (Render = 1; có thêm CDN như Cloudflare = 2). Bỏ trống = 1.
RATE_LIMIT_TRUSTED_PROXY_HOPS=

# URL công khai của app — dùng trong tin Zalo/SMS gửi khách (link theo dõi đơn).
# Trên Render để trống: tự dùng RENDER_EXTERNAL_URL.
PUBLIC_APP_URL=

# Bí mật ký phiên
SESSION_SECRET=

# Bí mật ký token máy gọi máy — Integration Layer (P7, YC-T8)
INTEGRATION_TOKEN_SECRET=

# Bí mật ký JWT phiên liên-app — Unified Shell SSO (B1). LocalBudd và
# SocialFlow xác minh JWT bằng CHÍNH khoá này (khoá đối xứng, chia sẻ giữa ba
# repo qua biến môi trường triển khai, không qua mã nguồn).
SSO_SESSION_SECRET=

# URL của SocialFlow/LocalBudd — dùng cho proxy server-side (P15+).
# Dashboard core gọi sibling qua proxy để tránh CORS trình duyệt.
# Ba cổng cục bộ: floraos-core 3100 / LocalBudd 3000 / SocialFlow 8000
SOCIALFLOW_URL=http://localhost:8000
LOCALBUDD_URL=http://localhost:3000

# Thư mục repo SocialFlow cho `npm run worker:socialflow` / `dev:all` (mặc định ../SocialFlow).
# npm KHÔNG tự đọc .env — export trong shell (vd. ~/.zshrc):
#   export SOCIALFLOW_DIR=~/ORGANIZED/02_PROJECTS/Active/SocialFlow
# SOCIALFLOW_DIR=

# URL công khai của SocialFlow/LocalBudd — dùng cho thẻ "mở sang" ở màn Trải
# nghiệm. Để trống khi chưa có bản triển khai thật.
NEXT_PUBLIC_SOCIALFLOW_URL=http://localhost:8000
NEXT_PUBLIC_LOCALBUDD_URL=http://localhost:3000

# Token Replicate — worker M04b dùng cho ReplicateOutpainter (mở rộng
# khung/outpainting, AIC-13, nợ #78, model bria/expand-image); M04a cũng
# khai cùng biến này cho ReplicateEnhancer (hiện là stub). Để trống thì cả
# hai tự lùi về bộ máy cục bộ, không lỗi job.
REPLICATE_API_TOKEN=

# IOPaint tự host (Mức 2, nợ #104, tiếp #78, mở rộng khung/outpainting
# AIC-13 — `IOPaintExpander`, `expand_provider="iopaint"`). Để trống
# IOPAINT_URL thì tự lùi về bộ máy cục bộ (PadExpander), không lỗi job —
# cùng nguyên tắc REPLICATE_API_TOKEN ở trên.
#
# Model mặc định: kandinsky-community/kandinsky-2-2-decoder-inpaint —
# giấy phép Apache-2.0 (xác nhận trên trang model, cả decoder và prior đi
# kèm), `support_outpainting=true` xác nhận đọc thẳng `iopaint/schema.py`
# (whitelist theo tên model, không theo họ SD/SDXL). KHÔNG dùng LaMa (mặc
# định của IOPaint) — không hỗ trợ outpainting (đã xác minh: dùng
# use_extender với LaMa trả 200 OK nhưng không mở rộng canvas). Đổi sang
# một model họ SD/SDXL-inpainting (chất lượng ảnh thật thường cao hơn
# Kandinsky cho ảnh sản phẩm) vẫn cần soát giấy phép riêng trước — xem
# `docker/iopaint/README.md`.
#
# `IOPAINT_DEVICE=mps` khi chạy native (không qua Docker) trên Apple
# Silicon — xem `docker/iopaint/run_native_mps.sh`. `cuda` cho triển khai
# thật (VPS có GPU NVIDIA).
#
# ĐÃ DỪNG làm đường thử tiếp theo 18/09 sau ma sát hạ tầng thật (Python
# không tương thích, hết dung lượng đĩa khi tải model) — xem
# docs/dac-ta/TECHNICAL_DEBT.md, mục cập nhật nợ #104. Mã vẫn giữ nguyên,
# để trống IOPAINT_URL (mặc định) là đủ.
IOPAINT_URL=
IOPAINT_MODEL=kandinsky-community/kandinsky-2-2-decoder-inpaint
IOPAINT_DEVICE=cuda
IOPAINT_TIMEOUT_SECONDS=120

# fal.ai (Mức 1 mới, nợ #105, tiếp #78/#104, 18/09) — `FalAIOutpainter`,
# `expand_provider="fal_bria_expand"`, gọi `fal-ai/bria/expand` (cùng
# model Bria với REPLICATE_API_TOKEN ở trên, khác hạ tầng chạy). Để trống
# FAL_KEY thì tự lùi về bộ máy cục bộ (PadExpander), không lỗi job — cùng
# nguyên tắc REPLICATE_API_TOKEN/IOPAINT_URL. Lấy key tại fal.ai (mục API
# Keys trong dashboard tài khoản).
FAL_KEY=
FAL_TIMEOUT_SECONDS=60

# Luồng NHÀ CUNG CẤP TRỌN GÓI của ảnh biến thể Khu vực D (PO 25/09/2026):
# thứ tự thử các nhà cung cấp (vai trò tương đương) khi job không chỉ định.
# Bên nào chưa có khoá (FAL_KEY / STABILITY_API_KEY) thì bị bỏ qua; bên lỗi →
# bên kế tiếp; mọi bên lỗi → lùi luồng cục bộ. Adapter: workers/media_ai/providers/scene/.
VARIANT_PROVIDER_ORDER=fal,stability

# Model tách chủ thể (nợ #109, 18/09; đổi mặc định 25/09 — Đợt 3 nâng cấp
# chất lượng ảnh) — worker M04b (`variant_worker.py`) và `RembgSegmenter` dùng
# `rembg`. Để trống thì dùng `isnet-general-use` (Apache-2.0, ~1,6 s/ảnh
# 1024 px trên CPU, ~1,2 GB RAM, giữ lá mảnh + hoa trắng trên nền trắng).
# KHÔNG dùng `bria-rmbg` (mặc định cũ) cho khách hàng thật: giấy phép
# bria-rmbg-1.4 chỉ phi thương mại (D18) — bảng giấy phép ở
# `workers/media_ai/providers/segmentation/mo_hinh.py`. Đặt `u2netp` để lặp
# nhanh khi code (nhẹ, nhưng làm mất hoa trắng trên nền trắng — đo 25/09).
# Xem docs/dac-ta/TECHNICAL_DEBT.md, nợ #109 và #137 (số #132–#136 đã dùng ở nhánh fix/app-shell-states).
VARIANT_SEGMENTATION_MODEL=

# Ngưỡng toàn vẹn chủ thể M04b (mặc định 0.99, hạ xuống 0.95 khi dùng
# u2netp trong môi trường dev). Chỉ áp dụng cho Local Studio Engine.
# Worker `variant_worker.py` đọc biến này: nếu `_do_lo_chu_the()` trả số
# nhỏ hơn ngưỡng thì job bị REJECTED và không ghi asset nào.
VARIANT_INTEGRITY_THRESHOLD=

# === AI CLOUD PROVIDERS & MULTI-PROVIDER ENGINE (SMEOS AI CAPABILITIES) ===
# smeOS áp dụng nguyên tắc Provider Single-Call & Provider Chain:
# Khi người dùng tạo ảnh sản phẩm, nội dung, video hay thuyết minh, hệ thống sẽ ưu tiên
# gọi các Provider Cloud trả phí này theo thứ tự đã cấu hình trong /cai-dat-ai.
# Nếu một provider gặp lỗi (hết quota, timeout...), hệ thống sẽ tự động chuyển sang bên tiếp theo,
# và cuối cùng tự động lùi về Local Engine an toàn nếu tất cả đều thiếu key/lỗi.

# 1. Google Gemini & Imagen API (Tối ưu ảnh thương mại, sinh phông nền Studio 2K, phân tích đa phương thức)
# Đăng ký & lấy key tại: https://aistudio.google.com/app/apikey hoặc Google Cloud Vertex AI
GEMINI_API_KEY=
GOOGLE_VERTEX_API_KEY=

# 2. OpenAI API (Tối ưu ảnh gpt-image-1, sinh nội dung GPT-4o, thuyết minh OpenAI TTS)
# Đăng ký & lấy key tại: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# 3. Photoroom API (Tách nền sản phẩm e-commerce, đổ bóng mềm tự nhiên, ánh sáng studio)
# Đăng ký & lấy key tại: https://photoroom.com/api (Dashboard > API Keys)
PHOTOROOM_API_KEY=

# 4. fal.ai API (Tách nền BiRefNet, BRIA Product Shot, Kling Video, Luma Ray 2)
# Đăng ký & lấy key tại: https://fal.ai/dashboard/keys
FAL_KEY=
FAL_TIMEOUT_SECONDS=60

# 5. Anthropic Claude API (Sinh nội dung kịch bản bán hàng, bài đăng Claude Opus 5 & Sonnet 5)
# Đăng ký & lấy key tại: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# 6. Stability AI API (Biến thể ảnh marketing, Relight thay đổi hướng sáng)
# Đăng ký & lấy key tại: https://platform.stability.ai/account/keys
STABILITY_API_KEY=

# 7. RunwayML API (Sinh video thương mại điện ảnh Runway Gen-4)
# Đăng ký & lấy secret tại: https://dev.runwayml.com/
RUNWAYML_API_SECRET=

# 8. ElevenLabs API (Lồng tiếng AI & Nhân bản giọng nói thương hiệu Instant Voice Clone)
# Đăng ký & lấy key tại: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# 9. MiniMax API (Giọng đọc thuyết minh tiếng Việt ấm áp)
# Đăng ký & lấy key tại: https://www.minimaxi.com/
MINIMAX_API_KEY=

# 10. Replicate API Token (Mở rộng khung ảnh / Outpainting Cloud)
# Đăng ký & lấy token tại: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# === FEATURE FLAGS ===
# Thẻ chào / Swipe Brochure module (§34.16)
# Mặc định: bật ("true"). LƯU Ý (soát 06/10/2026): hiện "false" CHỈ tắt bộ quét nền của Thẻ chào,
# CHƯA ẩn menu / route / API — nợ #179.
GREETING_CARD_ENABLED=true
# Bộ quét nền Thẻ chào (mỗi phút trong tiến trình web: gửi lại tin lỗi, nhắc/tự huỷ đơn quá hạn giữ).
# Đặt "off" để tắt riêng bộ quét.
GREETING_CARD_SWEEP=on

# D13 — dòng thông báo xử lý dữ liệu cá nhân dưới nút đặt hoa + trang /chinh-sach-bao-mat.
# Mặc định tắt (khách không thấy). Bật: true, rồi deploy lại (biến NEXT_PUBLIC_ gắn lúc build).
NEXT_PUBLIC_PRIVACY_NOTICE_ENABLED=

# Khóa các tính năng chưa mở (sidebar + thẻ trang chủ mờ, tuyến hiện "Sắp ra mắt").
# Chỉ đặt `production` trên dịch vụ production; dev/staging để trống. Gắn lúc build.
# Danh sách tính năng: src/lib/feature-lock.ts
NEXT_PUBLIC_APP_ENV=

# Secret cho endpoint cron nội bộ (vd. POST /api/v1/internal/chain-dispatch-sweep, header
# `x-cron-secret`). Production thiếu biến này thì endpoint luôn từ chối; dev để trống = "dev".
CRON_SECRET=

# URL công khai của app — dựng link gửi chi nhánh/khách (cron gọi qua host nội bộ).
NEXT_PUBLIC_APP_URL=http://localhost:3200

# Goong (goong.io) — đổi địa chỉ giao hàng / địa chỉ chi nhánh thành toạ độ để phân đơn gia công
# theo khoảng cách. Để trống: điều phối vẫn chạy nhưng không tính khoảng cách (trừ chi nhánh có
# vĩ độ/kinh độ nhập tay và đơn đã có toạ độ đệm).
GOONG_API_KEY=

# Zalo OA CHUNG của nền tảng — gửi lời mời/nhắc việc gia công cho nhân viên chi nhánh đã quan tâm
# OA và nhắn mã liên kết. Để trống: kênh Zalo tắt, Telegram vẫn chạy.
# APP_ID / APP_SECRET: ứng dụng Zalo đã được OA cấp quyền. REFRESH_TOKEN: chỉ dùng lần đầu, sau đó
# hệ thống tự làm mới và lưu (niêm phong) trong bảng platform_secrets.
# WEBHOOK_SECRET: "OA Secret Key" dùng ký webhook — trỏ webhook OA về /api/v1/public/zalo-oa/webhook.
ZALO_OA_APP_ID=
ZALO_OA_APP_SECRET=
ZALO_OA_REFRESH_TOKEN=
ZALO_OA_WEBHOOK_SECRET=
# Link quan tâm OA hiển thị cho cửa hàng (vd. https://zalo.me/<oa-id>)
ZALO_OA_FOLLOW_URL=
