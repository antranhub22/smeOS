  error_rate      Float?
  quota_status    String?
  last_checked_at DateTime               @default(now())

  @@index([status])
}

model research_runs {
  id                    String              @id
  run_type              research_run_type   @default(DAILY_DEEP)
  status                research_run_status @default(PENDING)
  started_at            DateTime?
  completed_at          DateTime?
  sources_attempted     Int                 @default(0)
  sources_succeeded     Int                 @default(0)
  sources_failed        Int                 @default(0)
  records_collected     Int                 @default(0)
  topics_created        Int                 @default(0)
  opportunities_created Int                 @default(0)
  error_summary         String?
  created_at            DateTime            @default(now())

  @@index([status, created_at])
}

model role_capabilities {
  id              String           @id
  role_id         String
  capability_code String
  scope           capability_scope @default(ORGANIZATION)
  roles           roles            @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@unique([role_id, capability_code])
}

model roles {
  id                String              @id
  organization_id   String?
  key               String
  name              String
  is_system         Boolean             @default(false)
  created_at        DateTime            @default(now())
  role_capabilities role_capabilities[]

  @@unique([organization_id, key])
  @@index([organization_id])
}

model sessions {
  id              String    @id
  user_id         String
  token_hash      String    @unique
  organization_id String?
  created_at      DateTime  @default(now())
  expires_at      DateTime
  revoked_at      DateTime?
  users           users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model staff_notifications {
  id              String        @id
  organization_id String
  order_id        String?
  event_key       String
  channel         String
  recipient_role  String?
  recipient_id    String?
  recipient_info  String?
  title           String?
  message         String?
  status          String        @default("SENT")
  provider_msg_id String?
  error           String?
  created_at      DateTime      @default(now())
  organizations   organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([organization_id, event_key])
  @@index([organization_id, recipient_id])
}

model template_overrides {
  id              String          @id
  organization_id String
  template_family template_family
  template_key    String
  field_key       String
  value           String
  updated_by      String
  created_at      DateTime        @default(now())
  updated_at      DateTime
  organizations   organizations   @relation(fields: [organization_id], references: [id])

  @@unique([organization_id, template_key, field_key])
  @@index([organization_id])
}

model topic_scores {
  id                        String   @id
  topic_id                  String
  geo_scope                 String   @default("VN")
  industry                  String   @default("florist")
  period                    String   @default("7d")
  trend_score               Float
  viral_score               Float
  commercial_score          Float
  content_opportunity_score Float
  confidence                Float    @default(1.0)
  calculated_at             DateTime @default(now())
  model_version             String   @default("v1_florist")
  topics                    topics   @relation(fields: [topic_id], references: [id], onDelete: Cascade)

  @@index([content_opportunity_score])
  @@index([period])
  @@index([topic_id])
}

model topic_signals {
  id                 String         @id
  topic_id           String
  source_id          String
  external_reference String?
  signal_type        String
  signal_value       Float
  captured_at        DateTime       @default(now())
  market_sources     market_sources @relation(fields: [source_id], references: [id], onDelete: Cascade)
  topics             topics         @relation(fields: [topic_id], references: [id], onDelete: Cascade)

  @@index([source_id])
  @@index([topic_id])
}

model topics {
  id                    String                  @id
  canonical_name        String
  description           String?
  language              String                  @default("vi")
  industry              String                  @default("florist")
  status                trend_topic_status      @default(EMERGING)
  first_seen_at         DateTime                @default(now())
  last_seen_at          DateTime                @default(now())
  content_opportunities content_opportunities[]
  topic_scores          topic_scores[]
  topic_signals         topic_signals[]
  trend_timeseries      trend_timeseries[]

  @@unique([canonical_name, industry])
  @@index([industry])
  @@index([last_seen_at])
  @@index([status])
}

model trend_signals {
  id             String         @id
  source_id      String
  platform       String
  country_code   String         @default("VN")
  region_code    String?
  city           String?
  industry       String         @default("florist")
  topic_raw      String
  metric_name    String
  metric_value   Float
  growth_rate    Float?
  confidence     Float          @default(1.0)
  captured_at    DateTime       @default(now())
  created_at     DateTime       @default(now())
  market_sources market_sources @relation(fields: [source_id], references: [id], onDelete: Cascade)

  @@unique([source_id, platform, country_code, topic_raw, captured_at])
  @@index([captured_at])
  @@index([industry])
  @@index([platform, country_code])
  @@index([source_id])
}

model trend_timeseries {
  id           String   @id
  topic_id     String
  platform     String
  geo_scope    String   @default("VN")
  date         DateTime
  value        Float
  growth_rate  Float?
  velocity     Float?
  acceleration Float?
  confidence   Float    @default(1.0)
  topics       topics   @relation(fields: [topic_id], references: [id], onDelete: Cascade)

  @@unique([topic_id, platform, geo_scope, date])
  @@index([date])
  @@index([topic_id])
}

model usage {
  id              String        @id
  organization_id String
  workspace_id    String
  user_id         String
  job_id          String?
  feature         String
  quantity        Int           @default(1)
  cost_credit     Int           @default(0)
  cost_usd        Float?
  status          String
  metadata        Json?
  created_at      DateTime      @default(now())
  organizations   organizations @relation(fields: [organization_id], references: [id])

  @@index([job_id])
  @@index([organization_id, created_at])
}

model users {
  id                 String              @id
  email              String              @unique
  password_hash      String?
  name               String?
  avatar_url         String?
  locale             String              @default("vi")
  created_at         DateTime            @default(now())
  updated_at         DateTime
  phone              String?
  memberships        memberships[]
  platform_operators platform_operators?
  sessions           sessions[]
}

model video_jobs {
  id                  String         @id
  organization_id     String
  product_id          String?
  title               String
  format              video_format
  stage               video_stage    @default(DRAFT)
  script_approval     approval_state @default(PENDING)
  script_approved_at  DateTime?
  script_approved_by  String?
  video_approval      approval_state @default(PENDING)
  video_approved_at   DateTime?
  video_approved_by   String?
  duration_seconds    Int            @default(15)
  aspect_ratio        String         @default("9:16")
  music_track         String?
  voice_code          String?
  has_subtitle        Boolean        @default(true)
  caption_style       String         @default("MODERN_BADGE")
  has_watermark       Boolean        @default(false)
  scene_plan_id       String?
  scene_plan_revision Int?
  audio_job_id        String?
  audio_storage_key   String?
  final_video_url     String?
  final_asset_id      String?
  cost_credits        Int            @default(0)
  error_message       String?
  created_at          DateTime       @default(now())
  updated_at          DateTime
  organizations       organizations  @relation(fields: [organization_id], references: [id])
  video_scenes        video_scenes[]

  @@index([organization_id])
  @@index([organization_id, product_id])
  @@index([script_approval])
  @@index([stage])
  @@index([video_approval])
}

model video_scenes {
  id                String     @id
  video_job_id      String
  scene_index       Int
  duration_seconds  Float      @default(3.0)
  image_asset_id    String?
  text_overlay      String?
  voice_script      String?
  transition_effect String?    @default("fade")
  motion_effect     String?
  created_at        DateTime   @default(now())
  video_jobs        video_jobs @relation(fields: [video_job_id], references: [id], onDelete: Cascade)

  @@unique([video_job_id, scene_index])
  @@index([video_job_id])
}

model voice_clones {
  id                 String        @id
  organization_id    String
  name               String
  provider           String        @default("elevenlabs")
  provider_voice_id  String?
  status             String        @default("PENDING")
  sample_storage_key String
  sample_mime_type   String
  sample_bytes       Int
  consent_text       String
  consented_by       String
  consented_at       DateTime
  job_id             String?
  error              String?
  created_at         DateTime      @default(now())
  updated_at         DateTime
  deleted_at         DateTime?
  organizations      organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([organization_id, status])
}

model vouchers {
  id               String                @id
  organization_id  String
  customer_id      String?
  code             String
  discount_type    voucher_discount_type @default(PERCENTAGE)
  discount_value   Decimal               @db.Decimal(14, 2)
  min_order_vnd    Decimal               @default(0) @db.Decimal(14, 2)
  max_discount_vnd Decimal?              @db.Decimal(14, 2)
  expires_at       DateTime?
  is_used          Boolean               @default(false)
  used_at          DateTime?
  order_id         String?
  created_at       DateTime              @default(now())
  customers        customers?            @relation(fields: [customer_id], references: [id])
  organizations    organizations         @relation(fields: [organization_id], references: [id])

  @@unique([organization_id, code])
  @@index([organization_id, customer_id])
}

model workspaces {
  id              String         @id
  organization_id String
  name            String
  kind            workspace_kind @default(PRODUCTION)
  trial_count     Int            @default(0)
  trial_limit     Int?
  trial_reset_at  DateTime?
  trial_status    trial_status?
  created_at      DateTime       @default(now())
  organizations   organizations  @relation(fields: [organization_id], references: [id])

  @@index([organization_id])
}

