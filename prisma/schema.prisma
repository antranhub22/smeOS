generator client {
  provider      = "prisma-client"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model ai_capabilities {
  code             String           @id
  module           String
  kind             String
  needs_approval   Boolean          @default(true)
  privacy_floor    ai_privacy_level @default(SHOP)
  accept_threshold Float?
  measure_channels Json
  enabled          Boolean          @default(true)
  updated_at       DateTime
  ai_policies      ai_policies[]
}

model ai_evaluations {
  id              String        @id
  organization_id String
  capability_code String
  entity_type     String
  entity_id       String
  scores          Json
  overall_score   Float
  threshold_used  Float?
  needs_review    Boolean       @default(false)
  reason          String?
  created_at      DateTime      @default(now())
  organizations   organizations @relation(fields: [organization_id], references: [id])

  @@index([organization_id, capability_code])
  @@index([organization_id, entity_type, entity_id])
}

model ai_models {
  id             String           @id
  key            String           @unique
  display_name   String
  provider       String
  mode           ai_mode
  capabilities   Json
  license        String
  commercial_use Boolean
  territory      String
  allowed_use    String
  cost_class     String
  latency_class  String
  quality_class  String
  measure_state  ai_measure_state @default(CHUA_DO)
  leaves_infra   Boolean
  enabled        Boolean          @default(false)
  version        String
  registered_by  String?
  created_at     DateTime         @default(now())
  updated_at     DateTime
}

model ai_policies {
  id              String           @id
  organization_id String
  capability_code String
  allowed_models  Json
  quality_target  String?
  cost_ceiling    Int?
  privacy_floor   ai_privacy_level
  updated_by      String
  updated_at      DateTime
  ai_capabilities ai_capabilities  @relation(fields: [capability_code], references: [code])
  organizations   organizations    @relation(fields: [organization_id], references: [id])

  @@unique([organization_id, capability_code])
  @@index([organization_id])
}

model ai_requests {
  id               String        @id
  organization_id  String
  job_id           String?
  capability_code  String
  model_key        String
  attempt          Int           @default(1)
  escalated_from   String?
  fallback_from    String?
  source           String
  input_tokens     Int?
  output_tokens    Int?
  image_count      Int?
  duration_seconds Float?
  gpu_seconds      Float?
  cost_usd         Float?
  latency_ms       Int?
  quality_score    Float?
  outcome          String
  created_at       DateTime      @default(now())
  organizations    organizations @relation(fields: [organization_id], references: [id])

  @@index([job_id])
  @@index([organization_id, capability_code, model_key])
  @@index([organization_id, created_at])
}

model assets {
  id               String         @id
  organization_id  String
  product_id       String?
  parent_asset_id  String?
  kind             asset_kind
  state            asset_state    @default(PROCESSING)
  version          Int            @default(1)
  storage_key      String
  thumb_key        String?
  mime_type        String
  width            Int?
  height           Int?
  aspect_ratio     String?
  file_size        Int?
  provider         String?
  model            String?
  model_version    String?
  pipeline_version String?
  parameters       Json?
  prompt           String?
  input_sha256     String?
  output_sha256    String?
  quality_score    Float?
  identity_score   Float?
  generated_flags  Json?
  cost_usd         Float?
  approval_state   approval_state @default(PENDING)
  approved_by      String?
  approved_at      DateTime?
  metadata         Json?
  created_by       String
  created_at       DateTime       @default(now())
  organizations    organizations  @relation(fields: [organization_id], references: [id])

  @@index([organization_id])
  @@index([organization_id, product_id])
  @@index([organization_id, product_id, kind, approval_state])
  @@index([output_sha256])
  @@index([parent_asset_id])
}

model audit_logs {
  id              String        @id
  organization_id String
  user_id         String
  action          String
  entity_type     String
  entity_id       String
  before          Json?
  after           Json?
  ip              String?
  user_agent      String?
  decision_id     String?
  ownership       String?
  decided_by      String?
  created_at      DateTime      @default(now())
  organizations   organizations @relation(fields: [organization_id], references: [id])

  @@index([entity_type, entity_id])
  @@index([organization_id, created_at])
}

model branches {
  id                String              @id
  organization_id   String
  name              String
  code              String
  address           String?
  is_active         Boolean             @default(true)
  created_at        DateTime            @default(now())
  organizations     organizations       @relation(fields: [organization_id], references: [id])
  product_inventory product_inventory[]

  @@unique([organization_id, code])
  @@index([organization_id])
}

model brand_profiles {
  id               String        @id
  organization_id  String        @unique
  primary_color    String?
  secondary_color  String?
  accent_color     String?
  background_color String?
  text_color       String?
  font_heading     String?
  font_body        String?
  logo_asset_id    String?
  tone_of_voice    String?
  hashtags         Json?
  cta_templates    Json?
  default_offers   Json?
  forbidden_styles Json?
  brand_assets     Json?
  created_at       DateTime      @default(now())
  updated_at       DateTime
  organizations    organizations @relation(fields: [organization_id], references: [id])
}

model business_profiles {
  id              String        @id
  organization_id String        @unique
  legal_name      String?
  display_name    String
  phone           String?
  email           String?
  address         String?
  website         String?
  social_links    Json?
  tax_code        String?
  description     String?
  operating_hours Json?
  created_at      DateTime      @default(now())
  updated_at      DateTime
  organizations   organizations @relation(fields: [organization_id], references: [id])
}

model campaign_packages {
  id                String        @id
  organization_id   String
  product_id        String?
  master_asset_id   String
  name              String
  mode              String
  topic             Json?
  content           Json?
  variant_asset_ids String[]      @default([])
  video_job_id      String?
  video_job_ids     String[]      @default([])
  audio_job_id      String?
  status            String        @default("DRAFT")
  qa_report         Json?
  qa_checked_at     DateTime?
  approved_by       String?
  approved_at       DateTime?
  launch_plan       Json?
  created_by        String
  created_at        DateTime      @default(now())
  updated_at        DateTime
  organizations     organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([organization_id, created_at])
  @@index([organization_id, master_asset_id])
  @@index([organization_id, status])
}

model capability_overrides {
  id              String        @id
  organization_id String
  role_id         String
  capability_code String
  allowed         Boolean
  updated_by      String
  updated_at      DateTime
  organizations   organizations @relation(fields: [organization_id], references: [id])

  @@unique([organization_id, role_id, capability_code])
  @@index([organization_id])
}

model catalog_links {
  id              String        @id
  organization_id String
  slug            String        @unique
  name            String
  description     String?
  filters         Json?
  is_revoked      Boolean       @default(false)
  revoked_at      DateTime?
  revoked_by      String?
  created_by      String
  created_at      DateTime      @default(now())
  updated_at      DateTime
  organizations   organizations @relation(fields: [organization_id], references: [id])

  @@index([organization_id])
  @@index([slug])
}

model chat_channel_integrations {
  id                      String        @id
  organization_id         String
  channel                 chat_channel
  is_enabled              Boolean       @default(false)
  config                  Json          @default("{}")
  subscription_expires_at DateTime?
  created_at              DateTime      @default(now())
  updated_at              DateTime
  organizations           organizations @relation(fields: [organization_id], references: [id])

  @@unique([organization_id, channel])
  @@index([organization_id, is_enabled])
}

model chat_conversations {
  id              String          @id
  organization_id String
  customer_id     String?
  title           String          @default("Hội thoại tư vấn hoa")
  channel         chat_channel    @default(WEB_WIDGET)
  status          String          @default("ACTIVE")
  created_at      DateTime        @default(now())
  updated_at      DateTime
  customers       customers?      @relation(fields: [customer_id], references: [id])
  organizations   organizations   @relation(fields: [organization_id], references: [id])
  chat_messages   chat_messages[]

  @@index([organization_id, customer_id])
  @@index([organization_id, status])
}

model chat_messages {
  id                 String             @id
  organization_id    String
  conversation_id    String
  sender_type        chat_sender_type
  content            String
  metadata           Json?
  created_at         DateTime           @default(now())
  chat_conversations chat_conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  organizations      organizations      @relation(fields: [organization_id], references: [id])

  @@index([organization_id, conversation_id, created_at])
}

model content_drafts {
  id              String        @id
  organization_id String
  asset_id        String
  topic_id        String
  mode            String
  topic_title     String?
  posts           Json
  created_by      String
  updated_by      String
  created_at      DateTime      @default(now())
  updated_at      DateTime
  organizations   organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@unique([organization_id, asset_id, topic_id, mode])
  @@index([organization_id, updated_at])
}

model content_generations {
  id              String        @id
  organization_id String
  job_id          String?
  origin          String
  asset_id        String?
  product_id      String?
  topic_id        String?
  scene_plan_id   String?
  mode            String?
  channels        Json
  brief           Json
  brief_version   Int
  prompt_versions Json
  rubric_version  String
  strategy        Json?
  posts           Json
  overall_score   Float?
  approved_posts  Json?
  status          String        @default("DRAFT")
  social_post_ids Json?
  created_by      String
  approved_by     String?
  created_at      DateTime      @default(now())
  updated_at      DateTime
  organizations   organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([organization_id, asset_id, topic_id, mode])
  @@index([organization_id, created_at])
}

model content_metrics {
  id              String        @id
  organization_id String
  platform        String
  content_id      String
  metric_date     DateTime      @db.Date
  reach           Int?
  impressions     Int?
  engagement      Int?
  clicks          Int?
  conversions     Int?
  spend_usd       Float?
  created_at      DateTime      @default(now())
  updated_at      DateTime
  organizations   organizations @relation(fields: [organization_id], references: [id])

  @@unique([organization_id, platform, content_id, metric_date])
  @@index([organization_id])
  @@index([organization_id, metric_date])
}

model content_opportunities {
  id                        String        @id
  organization_id           String
  topic_id                  String
  audience                  String?
  opportunity_summary       String
  content_angles            Json
  recommended_formats       Json
  recommended_hooks         Json
  trend_score               Float
  viral_score               Float
  commercial_score          Float
  content_opportunity_score Float
  confidence                Float         @default(1.0)
  expires_at                DateTime?
  created_at                DateTime      @default(now())
  updated_at                DateTime
  organizations             organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  topics                    topics        @relation(fields: [topic_id], references: [id], onDelete: Cascade)

  @@index([organization_id, content_opportunity_score])
  @@index([organization_id])
  @@index([topic_id])
}

model customer_consents {
  id              String          @id
  organization_id String
  customer_id     String
  channel         consent_channel
  granted         Boolean         @default(true)
  granted_at      DateTime        @default(now())
  revoked_at      DateTime?
  created_at      DateTime        @default(now())
  customers       customers       @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  organizations   organizations   @relation(fields: [organization_id], references: [id])

  @@unique([customer_id, channel])
  @@index([organization_id, customer_id])
}

model customer_occasions {
  id                   String        @id
  organization_id      String
  customer_id          String
  name                 String
  date                 String
  is_recurring         Boolean       @default(true)
  reminder_days_before Int           @default(7)
  recipient_name       String?
  notes                String?
  created_at           DateTime      @default(now())
  customers            customers     @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  organizations        organizations @relation(fields: [organization_id], references: [id])

  @@index([organization_id, customer_id])
  @@index([organization_id, date])
}

model customers {
  id                 String               @id
  organization_id    String
  code               String
  name               String
  phone              String
  email              String?
  address            String?
  tier               customer_tier        @default(NEW)
  notes              String?
  tags               String[]             @default([])
  preferred_flowers  String[]             @default([])
  preferred_colors   String[]             @default([])
  total_spent        Decimal              @default(0) @db.Decimal(14, 2)
  order_count        Int                  @default(0)
  last_order_at      DateTime?
  created_at         DateTime             @default(now())
  updated_at         DateTime
  chat_conversations chat_conversations[]
  customer_consents  customer_consents[]
  customer_occasions customer_occasions[]
  organizations      organizations        @relation(fields: [organization_id], references: [id])
  orders             orders[]
  vouchers           vouchers[]

  @@unique([organization_id, code])
  @@unique([organization_id, phone])
  @@index([organization_id, name])
  @@index([organization_id, tier])
}

model decision_registry {
  decision_id String   @id
  ownership   String
  locked      Boolean  @default(false)
  description String
  spec_ref    String?
  created_at  DateTime @default(now())
  updated_at  DateTime
}

model field_catalog_values {
  id             String         @id
  catalog_key    String
  code           String
  label          String
  description    String?
  sort_order     Int            @default(0)
  is_active      Boolean        @default(true)
  behavior       String?
  params         Json?
  created_at     DateTime       @default(now())
  updated_at     DateTime
  field_catalogs field_catalogs @relation(fields: [catalog_key], references: [key], onDelete: Cascade)

  @@unique([catalog_key, code])
  @@index([catalog_key])
}

model field_catalogs {
  id                   String                   @id
  key                  String                   @unique
  label                String
  governance           field_catalog_governance @default(OPEN)
  behavior_kind        String?
  created_at           DateTime                 @default(now())
  updated_at           DateTime
  field_catalog_values field_catalog_values[]
}

model field_config_overrides {
  id              String                   @id
  organization_id String
  target          field_override_target
  override_key    String
  label           String?
  visibility      Json?
  requirement     field_requirement_level?
  is_enabled      Boolean?
  created_by      String?
  updated_by      String?
  created_at      DateTime                 @default(now())
  updated_at      DateTime
  organizations   organizations            @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@unique([organization_id, target, override_key])
  @@index([organization_id])
}

model field_definitions {
  id                  String                  @id
  key                 String                  @unique
  entity              String
  origin              field_origin            @default(CORE)
  data_type           String
  label               String
  description         String?
  placeholder         String?
  placements          Json?
  requirement         field_requirement_level @default(OPTIONAL)
  required_at_stage   String?
  visibility          Json?
  validation          Json?
  catalog_key         String?
  sensitivity         field_sensitivity       @default(NORMAL)
  floor_internal_only Boolean                 @default(false)
  status              field_status            @default(ACTIVE)
  default_enabled     Boolean                 @default(true)
  created_by          String?
  updated_by          String?
  created_at          DateTime                @default(now())
  updated_at          DateTime

  @@index([catalog_key])
  @@index([entity])
}

model flower_confusable_pairs {
  ma_cap                                                             String          @id
  ma_loai_a                                                          String
  ma_loai_b                                                          String
  dau_hieu_tach_a                                                    String
  dau_hieu_tach_b                                                    String
  muc_do_nham                                                        String
  flower_taxonomy_flower_confusable_pairs_ma_loai_aToflower_taxonomy flower_taxonomy @relation("flower_confusable_pairs_ma_loai_aToflower_taxonomy", fields: [ma_loai_a], references: [ma_loai])
  flower_taxonomy_flower_confusable_pairs_ma_loai_bToflower_taxonomy flower_taxonomy @relation("flower_confusable_pairs_ma_loai_bToflower_taxonomy", fields: [ma_loai_b], references: [ma_loai])

  @@index([ma_loai_a])
  @@index([ma_loai_b])
  @@index([muc_do_nham])
}

model flower_taxonomy {
  ma_loai                                                                    String                    @id
  nhom                                                                       String
  cong_nang                                                                  String?
  ten_chuan                                                                  String
  ten_khac                                                                   Json
  nhom_hoa                                                                   String?
  dvt_chuan                                                                  String?
  so_bong_tren_dvt                                                           Int?
  duong_kinh_bong_cm                                                         Float?
  dien_tich_phu_cm2                                                          Float?
  ty_le_nhuy_tren_bong                                                       Float?
  mau_nhuy                                                                   String?
  kieu_moc                                                                   String?
  dai_mau_tu_nhien                                                           Json?
  dac_diem_phan_biet                                                         String?
  mua_vu                                                                     String?
  trang_thai                                                                 String                    @default("Đang dùng")
  created_at                                                                 DateTime                  @default(now())
  updated_at                                                                 DateTime
  flower_confusable_pairs_flower_confusable_pairs_ma_loai_aToflower_taxonomy flower_confusable_pairs[] @relation("flower_confusable_pairs_ma_loai_aToflower_taxonomy")
  flower_confusable_pairs_flower_confusable_pairs_ma_loai_bToflower_taxonomy flower_confusable_pairs[] @relation("flower_confusable_pairs_ma_loai_bToflower_taxonomy")

  @@index([nhom])
  @@index([ten_chuan])
}

model generation_jobs {
  id              String        @id
  organization_id String
  workspace_id    String
  branch_id       String?
  user_id         String
  product_id      String?
  feature         String
  status          job_status    @default(PENDING)
  stage           String?
  result          String?
  idempotency_key String?
  job_group_id    String?
  payload         Json
  output          Json?
  error           String?
  attempts        Int           @default(0)
  created_at      DateTime      @default(now())
  started_at      DateTime?
  completed_at    DateTime?
  cancelled_at    DateTime?
  organizations   organizations @relation(fields: [organization_id], references: [id])
  job_events      job_events[]

  @@unique([organization_id, feature, idempotency_key])
  @@index([organization_id])
  @@index([organization_id, job_group_id])
  @@index([organization_id, user_id])
  @@index([status, created_at])
}

model greeting_catalog_events {
  id                String            @id
  organization_id   String
  catalog_id        String
  channel           String
  event_type        String
  visitor_hash      String
  order_id          String?
  product_id        String?
  created_at        DateTime          @default(now())
  greeting_catalogs greeting_catalogs @relation(fields: [catalog_id], references: [id], onDelete: Cascade)
  organizations     organizations     @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([organization_id, catalog_id, created_at])
  @@index([organization_id, catalog_id, product_id])
  @@index([organization_id, channel])
}

model greeting_catalog_products {
  id                String            @id
  organization_id   String
  catalog_id        String
  product_id        String
  sort_order        Int               @default(0)
  created_at        DateTime          @default(now())
  greeting_catalogs greeting_catalogs @relation(fields: [catalog_id], references: [id], onDelete: Cascade)
  organizations     organizations     @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  products          products          @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([catalog_id, product_id])
  @@index([organization_id, catalog_id])
  @@index([product_id])
}

model greeting_catalogs {
  id                        String                      @id
  organization_id           String
  code                      String
  name                      String
  type                      String                      @default("STANDARD")
  description               String?
  filters                   Json?
  is_active                 Boolean                     @default(true)
  created_by                String
  created_at                DateTime                    @default(now())
  updated_at                DateTime
  greeting_catalog_events   greeting_catalog_events[]
  greeting_catalog_products greeting_catalog_products[]
  organizations             organizations               @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  greeting_sessions         greeting_sessions[]
  greeting_share_links      greeting_share_links[]

  @@unique([organization_id, code])
  @@index([organization_id])
}

model greeting_integrations {
  id                            String        @id
  organization_id               String        @unique
  payment_provider              String?
  payment_webhook_key_hash      String?       @unique
  payment_webhook_key_hint      String?
  payment_webhook_enabled       Boolean       @default(false)
  notify_channel                String?
  notify_enabled                Boolean       @default(false)
  notify_config_encrypted       String?
  notify_templates              Json?
  created_at                    DateTime      @default(now())
  updated_at                    DateTime
  staff_notify_channels         Json?
  staff_notify_config_encrypted String?
  staff_notify_enabled          Boolean       @default(false)
  staff_notify_events           Json?
  organizations                 organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([organization_id])
}

model greeting_journey_events {
  id                String            @id
  organization_id   String
  session_id        String
  event_type        String
  metadata          Json?
  created_at        DateTime          @default(now())
  organizations     organizations     @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  greeting_sessions greeting_sessions @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@index([organization_id, session_id])
}

model greeting_message_reads {
  id                String            @id
  organization_id   String
  message_id        String
  user_id           String
  read_at           DateTime          @default(now())
  greeting_messages greeting_messages @relation(fields: [message_id], references: [id], onDelete: Cascade)
  organizations     organizations     @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@unique([message_id, user_id])
  @@index([organization_id, user_id])
}

model greeting_messages {
  id                     String                   @id
  organization_id        String
  order_id               String?
  session_id             String?
  step_key               String                   @default("GENERAL")
  sender_id              String
  sender_role            String
  to_role                String?
  to_user_id             String?
  kind                   String                   @default("MESSAGE")
  body                   String
  payload                Json?
  reply_to_id            String?
  created_at             DateTime                 @default(now())
  greeting_message_reads greeting_message_reads[]
  organizations          organizations            @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([organization_id, order_id])
  @@index([organization_id, session_id])
  @@index([organization_id, to_role, created_at])
  @@index([organization_id, to_user_id, created_at])
}

model greeting_notifications {
  id                  String        @id
  organization_id     String
  order_id            String
  event_key           String
  channel             String
  recipient_masked    String
  status              String
  provider_message_id String?
  error               String?
  created_at          DateTime      @default(now())
  updated_at          DateTime
  organizations       organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@unique([organization_id, order_id, event_key])
  @@index([organization_id, order_id])
}

model greeting_payment_events {
  id              String        @id
  organization_id String
  provider        String
  external_id     String
  amount_vnd      Decimal       @db.Decimal(14, 2)
  content         String
  account_no      String?
  transaction_at  DateTime?
