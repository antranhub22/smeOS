{
  "name": "smeos",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3200",
    "predev:all": "docker compose up -d && (which ollama >/dev/null && (curl -s http://127.0.0.1:11434/api/tags >/dev/null || (brew services start ollama 2>/dev/null || ollama serve >/dev/null 2>&1 &)) || true)",
    "dev:all": "concurrently -k -p \"[{name}]\" -n \"web,vision,media,video,socialflow,localbudd,marketintel\" -c \"cyan.bold,green.bold,magenta.bold,red.bold,yellow.bold,blue.bold,white.bold\" \"npm run dev\" \"npm run worker:vision\" \"npm run worker:media\" \"npm run worker:video\" \"npm run worker:socialflow\" \"npm run worker:localbudd\" \"npm run worker:market-intelligence\"",
    "dev:core": "concurrently -k -p \"[{name}]\" -n \"web,vision,media,video,marketintel\" -c \"cyan.bold,green.bold,magenta.bold,red.bold,white.bold\" \"npm run dev\" \"npm run worker:vision\" \"npm run worker:media\" \"npm run worker:video\" \"npm run worker:market-intelligence\"",
    "worker:vision": "cd workers && set -a && [ -f ../.env ] && . ../.env && set +a && if [ -f .venv/bin/python ]; then .venv/bin/python -m vision.jobs.worker; else python3 -m vision.jobs.worker; fi",
    "worker:media": "cd workers && set -a && [ -f ../.env ] && . ../.env && set +a && if [ -f .venv/bin/python ]; then .venv/bin/python -m media_ai.jobs.worker; else python3 -m media_ai.jobs.worker; fi",
    "worker:video": "cd workers && set -a && [ -f ../.env ] && . ../.env && set +a && if [ -f .venv/bin/python ]; then .venv/bin/python -m media_ai.video.video_worker; else python3 -m media_ai.video.video_worker; fi",
    "worker:socialflow": "SF_DIR=\"${SOCIALFLOW_DIR:-../SocialFlow}\"; if [ -d \"$SF_DIR/backend\" ]; then cd \"$SF_DIR/backend\" && if [ -f ../venv/bin/python ]; then ../venv/bin/python -m uvicorn main:app --port 8000 --reload; else uvicorn main:app --port 8000 --reload; fi; else echo \"[socialflow] Khong tim thay $SF_DIR/backend (dat SOCIALFLOW_DIR tro toi repo SocialFlow), bo qua worker nay.\" && sleep 86400; fi",
    "worker:localbudd": "if [ -d ../LocalBudd ]; then cd ../LocalBudd && npm run dev; else echo '[localbudd] Khong tim thay ../LocalBudd, bo qua worker nay.' && sleep 86400; fi",
    "worker:market-intelligence": "tsx --env-file-if-exists=.env src/modules/market-intelligence/jobs/worker.ts",
    "build": "next build",
    "start": "next start -p 3200",
    "lint": "eslint",
    "lint:ux": "tsx scripts/ux-lint.ts",
    "audit:industry": "tsx scripts/industry-term-audit.ts --fix-hints",
    "audit:industry:check": "tsx scripts/industry-term-audit.ts --check",
    "audit:industry:baseline": "tsx scripts/industry-term-audit.ts --update-baseline",
    "audit:industry:json": "tsx scripts/industry-term-audit.ts --json",
    "check:industry": "tsx scripts/check-industry.ts --check",
    "check:layers": "tsx scripts/check-layer-boundaries.ts",
    "new:industry": "tsx scripts/new-industry.ts",
    "setup:hooks": "tsx scripts/setup-hooks.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude 'tests/tenant/**' --exclude 'tests/platform/**' --exclude 'node_modules/**'",
    "test:harvest": "tsx --test tests/maChucNang.test.ts",
    "test:tenant": "DATABASE_URL=\"${DATABASE_URL_TEST:-postgresql://smeos:smeos@localhost:5433/smeos_test}\" vitest run tests/tenant",
    "test:platform": "DATABASE_URL=\"${DATABASE_URL_TEST:-postgresql://smeos:smeos@localhost:5433/smeos_test}\" vitest run tests/platform",
    "db:test:setup": "bash scripts/dung-db-test.sh",
    "test:e2e": "playwright test",
    "test:e2e:ux": "playwright test tests/e2e/ux",
    "dev:link-skills": "node scripts/dev-link-skills.mjs",
    "nap:danh-muc": "tsx --env-file-if-exists=.env scripts/nap-avi-gift-vao-core.ts",
    "nap:phan-tich": "tsx --env-file-if-exists=.env scripts/nap-avi-gift-phan-tich.ts",
    "nap:credit": "tsx --env-file-if-exists=.env scripts/nap-credit.ts",
    "khoa:tai-khoan-mau": "tsx --env-file-if-exists=.env scripts/khoa-tai-khoan-mau.ts",
    "don-tai-khoan": "tsx --env-file-if-exists=.env scripts/don-tai-khoan.ts",
    "tao-tai-khoan-test": "tsx --env-file-if-exists=.env scripts/tao-tai-khoan-test.ts",
    "doi-chieu": "tsx --env-file-if-exists=.env scripts/doi-chieu-avi-gift.ts",
    "hoan-credit": "tsx --env-file-if-exists=.env scripts/hoan-credit.ts",
    "mat-khau": "tsx --env-file-if-exists=.env scripts/dat-lai-mat-khau.ts",
    "them-thanh-vien": "tsx --env-file-if-exists=.env scripts/them-thanh-vien.ts",
    "quet-job-treo": "tsx --env-file-if-exists=.env scripts/scan-stuck-jobs.ts",
    "gan-van-hanh-nen-tang": "tsx --env-file-if-exists=.env scripts/gan-van-hanh-nen-tang.ts",
    "db:push": "prisma db push",
    "db:deploy": "node scripts/db-deploy.mjs",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "db:seed:dev": "tsx --env-file-if-exists=.env prisma/seed/dev-shop-moclan.ts",
    "clean:siin-orders": "tsx --env-file-if-exists=.env prisma/seed/clean-siin-store-orders.ts",
    "handover:clean": "tsx --env-file-if-exists=.env scripts/handover-clean-tenant.ts",
    "handover:clean:dry": "tsx --env-file-if-exists=.env scripts/handover-clean-tenant.ts --dry-run",
    "handover:clean:prod": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.production scripts/handover-clean-tenant.ts",
    "handover:clean:prod:dry": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.production scripts/handover-clean-tenant.ts --dry-run",
    "handover:restore": "tsx --env-file-if-exists=.env scripts/handover-restore-tenant.ts",
    "handover:restore:prod": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.production scripts/handover-restore-tenant.ts",
    "db:studio": "prisma studio",
    "nap:loai": "tsx --env-file-if-exists=.env scripts/nap-danh-muc-loai.ts",
    "cham:bo-anh-vang": "python3 scripts/cham-bo-anh-vang.py",
    "check:template-ssot": "tsx scripts/check-template-ssot.ts",
    "gen:schemas:creative": "tsx scripts/gen-creative-studio-schemas.ts",
    "check:schemas:creative": "tsx scripts/gen-creative-studio-schemas.ts --check",
    "gen:schemas:coordinator": "tsx scripts/gen-coordinator-schemas.ts",
    "check:schemas:coordinator": "tsx scripts/gen-coordinator-schemas.ts --check",
    "gen:schemas:content-engine": "tsx scripts/gen-content-engine-schemas.ts",
    "check:schemas:content-engine": "tsx scripts/gen-content-engine-schemas.ts --check",
    "check:docs": "node scripts/check-docs.mjs",
    "seed:field-registry": "tsx --env-file-if-exists=.env scripts/nap-danh-muc-truong.ts",
    "check:field-registry": "tsx --env-file-if-exists=.env scripts/check-field-registry.ts",
    "lint:decisions": "tsx scripts/lint-decision-registry.ts",
    "lint:manifests": "tsx scripts/lint-journey-manifests.ts",
    "lint:ratchet": "node scripts/eslint-ratchet.mjs",
    "copywrite:style": "tsx scripts/apply-copywrite-style.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@base-ui/react": "^1.9.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "html-to-image": "^1.11.13",
    "ioredis": "^5.11.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "nodemailer": "^10.1.1",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "prisma": "^7.10.1",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
